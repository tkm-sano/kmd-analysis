      "status": "B"
    },
    {
      "id": "P2_dc",
      "x": 540,
      "y": 392,
      "w": 140,
      "h": 59,
      "title": "A/B 車両・走行計算",
      "body": "走行総質量m=共通質量+M\n転がり・加速の仕事が変化\n出力：DC電力量 E_DC",
      "status": "A"
    },
