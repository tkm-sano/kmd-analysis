{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kmd/research_portal_registry.schema.json",
  "title": "KMD Research Portal Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "updated_at",
    "review",
    "review_policy",
    "default_view_id",
    "current_stage_ref",
    "metadata",
    "simulation_map",
    "evidence",
    "nodes",
    "relations",
    "views",
    "groups",
    "known_conflicts",
    "scenario_lanes",
    "quantum_scales",
    "model_layers",
    "implementation_links",
    "external_sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_id": { "$ref": "#/$defs/id" },
    "registry_version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "review": { "$ref": "#/$defs/review" },
    "review_policy": { "const": "record_review_overrides_root_otherwise_inherit_root" },
    "default_view_id": { "$ref": "#/$defs/id" },
    "current_stage_ref": { "$ref": "#/$defs/id" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_ja", "scope_note_ja"],
      "properties": {
        "title_ja": { "$ref": "#/$defs/nonEmptyString" },
        "title_en": { "$ref": "#/$defs/nonEmptyString" },
        "scope_note_ja": { "$ref": "#/$defs/nonEmptyString" },
        "scope_note_en": { "$ref": "#/$defs/nonEmptyString" },
        "research_overview_ja": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "simulation_map": { "$ref": "#/$defs/simulationMap" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/view" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "known_conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "scenario_lanes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/scenarioLane" }
    },
    "quantum_scales": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/quantumScale" }
    },
    "model_layers": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/modelLayer" }
    },
    "implementation_links": {
      "type": "array",
      "items": { "$ref": "#/$defs/implementationLink" }
    },
    "external_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalSource" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "status": {
      "enum": ["implemented", "in_progress", "planned", "blocked", "unknown"]
    },
    "readiness": {
      "enum": ["accepted", "provisional", "not_accepted", "not_evaluated", "unknown"]
    },
    "nature": {
      "enum": [
        "repository_grounded",
        "repository_grounded_design",
        "hypothesis",
        "external_model"
      ]
    },
    "unknownReasonType": {
      "enum": ["data_missing", "parameter_not_set", "assumption_not_adopted", "model_not_formalized", "not_calculated", "evidence_not_accepted", "external_model_not_selected"]
    },
    "urgency": { "enum": ["critical", "high", "medium", "low", "none"] },
    "informationCategory": {
      "enum": ["open_data", "model_parameter", "derived_value", "problem_size"]
    },
    "valueOrigin": {
      "enum": ["open_data", "research_setting", "model_derived", "simulation_output", "unknown"]
    },
    "mapCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "icon"],
      "properties": {
        "id": { "enum": ["open_data", "model_parameter", "derived_value", "problem_size"] },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "icon": { "enum": ["source", "control", "calculation", "dimension"] }
      }
    },
    "mapItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "information_category", "value_origin"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "information_category": { "$ref": "#/$defs/informationCategory" },
        "value_origin": { "$ref": "#/$defs/valueOrigin" },
        "adoption_status": { "enum": ["adopted", "candidate", "reference", "future"] },
        "source_registry_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "description_ja": { "$ref": "#/$defs/nonEmptyString" },
        "definition_ja": { "$ref": "#/$defs/nonEmptyString" },
        "geographic_scope": { "type": ["string", "null"] },
        "time_basis": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "value": {
          "anyOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "string" },
            { "type": "array", "items": { "type": ["number", "string"] } },
            { "type": "null" }
          ]
        },
        "value_status": { "enum": ["known", "known_proxy", "unresolved"] },
        "role_by_scenario": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current": { "enum": ["fixed_condition", "scenario_variable", "derived", "output"] },
            "battery": { "enum": ["fixed_condition", "scenario_variable", "derived", "output"] },
            "social": { "enum": ["fixed_condition", "scenario_variable", "derived", "output"] }
          }
        },
        "unknown_reason_type": { "$ref": "#/$defs/unknownReasonType" },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "urgency": { "$ref": "#/$defs/urgency" },
        "used_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "determined_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "repo_input_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "external_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "uniqueItems": true
        },
        "evidence_ref": { "$ref": "#/$defs/id" }
      }
    },
    "mapProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "stage", "registry_node_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "stage": { "enum": ["delivery_generation", "optimization_representation", "solver", "simulation"] },
        "registry_node_ref": { "$ref": "#/$defs/id" }
      }
    },
    "mapEvaluationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geography", "geography_unknown_reason", "time", "time_unknown_reason", "scenario", "scenario_unknown_reason"],
      "properties": {
        "geography": { "type": ["string", "null"] },
        "geography_unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "time": { "type": ["string", "null"] },
        "time_unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "scenario": { "type": ["string", "null"] },
        "scenario_unknown_reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "mapEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "information_category", "value_origin", "value", "value_status", "unit", "definition_ja", "formula", "numerator_ref", "denominator_ref", "registry_node_ref", "evaluation_scope", "unknown_reason_type", "unknown_reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "information_category": { "const": "derived_value" },
        "value_origin": { "$ref": "#/$defs/valueOrigin" },
        "value": { "type": ["number", "null"] },
        "value_status": { "enum": ["known", "unresolved"] },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "definition_ja": { "$ref": "#/$defs/nonEmptyString" },
        "formula": { "$ref": "#/$defs/nonEmptyString" },
        "numerator_ref": { "$ref": "#/$defs/id" },
        "denominator_ref": { "$ref": "#/$defs/id" },
        "registry_node_ref": { "$ref": "#/$defs/id" },
        "evaluation_scope": { "$ref": "#/$defs/mapEvaluationScope" },
        "unknown_reason_type": { "$ref": "#/$defs/unknownReasonType" },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "mapAuxiliaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "role_ja"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "role_ja": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "mapPropagationRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "propagation_type", "effect_label_ja", "effect_semantics", "propagation_scope", "applicable_scenarios"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "propagation_type": {
          "enum": ["condition_propagation", "demand_propagation", "problem_size_propagation", "simulation_outcome_propagation"]
        },
        "effect_label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "effect_semantics": { "enum": ["direct", "derived", "conditional", "unresolved"] },
        "propagation_scope": { "enum": ["scenario_variable", "fixed_input", "model_derived", "simulation_output"] },
        "applicable_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["current", "battery", "social"] },
          "uniqueItems": true
        },
        "unresolved_reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "simulationMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["information_categories", "open_data", "model_parameters", "derived_values", "problem_sizes", "process_nodes", "final_evaluation", "auxiliary_metrics", "propagation_relations"],
      "properties": {
        "information_categories": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/mapCategory" } },
        "open_data": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapItem" } },
        "model_parameters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapItem" } },
        "derived_values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapItem" } },
        "problem_sizes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapItem" } },
        "process_nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapProcess" } },
        "final_evaluation": { "$ref": "#/$defs/mapEvaluation" },
        "auxiliary_metrics": { "type": "array", "items": { "$ref": "#/$defs/mapAuxiliaryMetric" } },
        "propagation_relations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapPropagationRelation" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by", "reviewed_at"],
      "properties": {
        "reviewed_by": {
          "type": ["string", "null"],
          "minLength": 1,
          "not": { "const": "unknown" }
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "properties": { "reviewed_by": { "type": "null" } }, "required": ["reviewed_by"] },
              { "properties": { "reviewed_at": { "type": "null" } }, "required": ["reviewed_at"] }
            ]
          },
          "then": { "required": ["unknown_reason"] }
        }
      ]
    },
    "unknownItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "unknown_reason", "confirmation_method"],
      "properties": {
        "field": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": "null" },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "confirmation_method": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "statusHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_at", "from", "to", "reason_ja", "evidence_refs", "review"],
      "properties": {
        "changed_at": { "type": "string", "format": "date" },
        "from": { "anyOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }] },
        "to": { "$ref": "#/$defs/status" },
        "reason_ja": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_ja",
        "summary_ja",
        "kind",
        "status",
        "readiness",
        "nature",
        "current_state_ja",
        "not_claimed_ja",
        "evidence_refs",
        "limitations_ja",
        "tags"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "label_en": { "$ref": "#/$defs/nonEmptyString" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "summary_en": { "$ref": "#/$defs/nonEmptyString" },
        "kind": {
          "enum": [
            "research_question",
            "stage",
            "dataset",
            "dataset_group",
            "model",
            "external_model",
            "experiment_instance",
            "method",
            "simulation",
            "metric",
            "metric_group",
            "variable",
            "parameter",
            "hypothesis",
            "analysis",
            "outcome",
            "evidence_group",
            "issue"
          ]
        },
        "status": { "$ref": "#/$defs/status" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "nature": { "$ref": "#/$defs/nature" },
        "current_state_ja": { "$ref": "#/$defs/nonEmptyString" },
        "not_claimed_ja": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "limitations_ja": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "uniqueItems": true
        },
        "parent_node_ref": { "$ref": "#/$defs/id" },
        "group_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedField" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/namedField" }
        },
        "problem_scale": {
          "type": "array",
          "items": { "$ref": "#/$defs/problemScale" }
        },
        "metric_definition": { "$ref": "#/$defs/metricDefinition" },
        "unit": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "time_basis": { "type": ["string", "null"] },
        "geographic_scope": { "type": ["string", "null"] },
        "resolution_status": {
          "enum": ["open", "actively_resolving", "deferred", "resolved"]
        },
        "scope_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "intentionally_isolated": { "type": "boolean" },
        "isolation_reason_ja": { "$ref": "#/$defs/nonEmptyString" },
        "execution_modality": { "enum": ["classical", "classical_quantum_circuit_simulator", "quantum_hardware", "not_applicable"] },
        "hardware_execution": { "type": "boolean" },
        "quantum_advantage_claimed": { "type": "boolean" },
        "completed_scope_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "remaining_scope_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "next_actions_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "entry_conditions_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "expected_outputs_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "unblock_conditions_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "unknown_reason_type": { "$ref": "#/$defs/unknownReasonType" },
        "urgency": { "$ref": "#/$defs/urgency" },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "confirmation_method": { "$ref": "#/$defs/nonEmptyString" },
        "unknowns": {
          "type": "array",
          "items": { "$ref": "#/$defs/unknownItem" }
        },
        "review": { "$ref": "#/$defs/review" },
        "status_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/statusHistory" }
        },
        "role_by_scenario": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current": { "$ref": "#/$defs/roleList" },
            "battery": { "$ref": "#/$defs/roleList" },
            "social": { "$ref": "#/$defs/roleList" },
            "quantum_scale": { "$ref": "#/$defs/roleList" }
          }
        },
        "reference_models": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "possible_upstream_models": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "red_reasons": { "type": "array", "items": { "enum": ["value_unresolved", "not_calculated", "model_not_adopted", "hypothesis_only", "design_only", "external_reference_only"] }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "in_progress" } }, "required": ["status"] },
          "then": { "required": ["completed_scope_ja", "remaining_scope_ja", "next_actions_ja"] }
        },
        {
          "if": { "properties": { "status": { "const": "planned" } }, "required": ["status"] },
          "then": { "required": ["entry_conditions_ja", "expected_outputs_ja"] }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
          "then": { "required": ["unblock_conditions_ja"] }
        },
        {
          "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
          "then": { "required": ["unknown_reason", "confirmation_method"] }
        }
      ]
    },
    "modelLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "summary_ja", "node_refs", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "label_en": { "$ref": "#/$defs/nonEmptyString" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "node_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "implementationLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_ref", "role", "path", "summary_ja", "status", "readiness"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "node_ref": { "$ref": "#/$defs/id" },
        "role": { "enum": ["input_data", "specification", "configuration", "process", "artifact", "validation", "acceptance", "unconfirmed"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_ref": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "warning_ja": { "$ref": "#/$defs/nonEmptyString" },
        "portability": { "enum": ["tracked", "untracked_local", "ignored_local", "external_required"] }
      }
    },
    "externalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "kind", "locator", "purpose_ja", "adoption_status", "node_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["open_data", "paper", "external_model", "documentation"] },
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "purpose_ja": { "$ref": "#/$defs/nonEmptyString" },
        "adoption_status": { "enum": ["adopted", "candidate", "reference_only"] },
        "node_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "warning_ja": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "namedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "value", "unit", "definition_ja"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "symbol": { "type": ["string", "null"] },
        "value": { "type": ["number", "integer", "string", "boolean", "null"] },
        "unit": { "type": ["string", "null"] },
        "definition_ja": { "$ref": "#/$defs/nonEmptyString" },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "unknown_reason_type": { "$ref": "#/$defs/unknownReasonType" }
      }
    },
    "roleList": {
      "type": "array",
      "items": {
        "enum": [
          "scenario_variable",
          "fixed_condition",
          "derived",
          "endogenous",
          "outcome",
          "core_research_object",
          "comparison_method",
          "external_evidence",
          "reference_model"
        ]
      },
      "uniqueItems": true
    },
    "scenarioLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "summary_ja", "node_refs", "relation_refs", "focus_node_refs", "steps"],
      "properties": {
        "id": { "enum": ["current", "battery", "social"] },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "node_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "relation_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "focus_node_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/laneStep" } }
      }
    },
    "laneStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "node_ref", "role", "value_status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "node_ref": { "$ref": "#/$defs/id" },
        "role": { "enum": ["scenario_variable", "fixed_condition", "derived", "endogenous", "outcome", "core_research_object", "comparison_method", "external_evidence", "reference_model"] },
        "value_status": { "enum": ["known", "unresolved", "not_calculated", "not_applicable"] },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "unknown_reason_type": { "$ref": "#/$defs/unknownReasonType" }
      }
    },
    "quantumScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "status", "readiness", "nature", "stages", "evidence_refs"],
      "properties": {
        "id": { "enum": ["logistics_evrp", "battery_cell_chemistry"] },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/status" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "nature": { "$ref": "#/$defs/nature" },
        "stages": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/quantumScaleStage" }
        },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "quantumScaleStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "value", "value_status", "unknown_reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": ["string", "number", "array", "null"] },
        "value_status": { "enum": ["known", "unresolved", "not_applicable"] },
        "unknown_reason": { "type": ["string", "null"] },
        "node_ref": { "$ref": "#/$defs/id" }
      }
    },
    "problemScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "symbol", "value", "unit", "definition_ja", "role", "owner_node_ref", "evidence_ref", "derivation_method", "scope", "time_basis", "geographic_scope"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "symbol": { "type": ["string", "null"] },
        "value": {
          "anyOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "array", "minItems": 1, "items": { "type": "number" } },
            { "type": "null" }
          ]
        },
        "unit": { "type": ["string", "null"] },
        "definition_ja": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["current_candidate", "formal_current", "planned", "proxy", "sensitivity", "derived"] },
        "owner_node_ref": { "$ref": "#/$defs/id" },
        "evidence_ref": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "derivation_method": { "type": ["string", "null"] },
        "derived_from_scale_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "scope": { "type": ["string", "null"] },
        "time_basis": { "type": ["string", "null"] },
        "geographic_scope": { "type": ["string", "null"] },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "metricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ja", "symbol", "unit", "numerator", "denominator", "transformation", "scope", "time_basis", "geographic_scope"],
      "properties": {
        "definition_ja": { "$ref": "#/$defs/nonEmptyString" },
        "symbol": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "numerator": { "type": ["string", "null"] },
        "denominator": { "type": ["string", "null"] },
        "transformation": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "time_basis": { "type": ["string", "null"] },
        "geographic_scope": { "type": ["string", "null"] },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_ja",
        "summary_ja",
        "source",
        "target",
        "type",
        "status",
        "nature",
        "evidence_refs",
        "limitations_ja"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "label_en": { "$ref": "#/$defs/nonEmptyString" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "summary_en": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "inputs_to",
            "transforms_to",
            "parameterizes",
            "produces",
            "evaluated_by",
            "compares_with",
            "depends_on",
            "blocked_by",
            "calibrated_by",
            "validated_by",
            "supports",
            "hypothesizes_influence_on",
            "projects_to",
            "supersedes"
          ]
        },
        "status": { "$ref": "#/$defs/status" },
        "nature": { "$ref": "#/$defs/nature" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "limitations_ja": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "derived_from_scale_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "common_instance_ref": { "$ref": "#/$defs/id" },
        "comparison_conditions_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "uncertainty_ja": { "$ref": "#/$defs/nonEmptyString" },
        "entry_conditions_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "expected_outputs_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "unblock_conditions_ja": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "unknown_reason": { "$ref": "#/$defs/nonEmptyString" },
        "confirmation_method": { "$ref": "#/$defs/nonEmptyString" },
        "review": { "$ref": "#/$defs/review" },
        "scenario_ids": { "type": "array", "items": { "enum": ["current", "battery", "social", "quantum_scale"] }, "uniqueItems": true },
        "relation_class": { "enum": ["transformation", "scenario_input", "fixed_condition_input", "derives", "constrains", "evaluated_by", "compared_by", "produces", "reference_only"] },
        "status_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/statusHistory" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "compares_with" } }, "required": ["type"] },
          "then": { "required": ["common_instance_ref", "comparison_conditions_ja"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["hypothesizes_influence_on", "projects_to"] } }, "required": ["type"] },
          "then": { "required": ["uncertainty_ja"] }
        },
        {
          "if": { "properties": { "status": { "const": "planned" } }, "required": ["status"] },
          "then": { "required": ["entry_conditions_ja", "expected_outputs_ja"] }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
          "then": { "required": ["unblock_conditions_ja"] }
        },
        {
          "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
          "then": { "required": ["unknown_reason", "confirmation_method"] }
        }
      ]
    },
    "supportTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_id"],
      "properties": {
        "target_type": { "enum": ["node", "relation"] },
        "target_id": { "$ref": "#/$defs/id" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "heading": { "$ref": "#/$defs/nonEmptyString" },
        "csv_key": { "$ref": "#/$defs/nonEmptyString" },
        "yaml_pointer": { "$ref": "#/$defs/nonEmptyString" },
        "json_pointer": { "$ref": "#/$defs/nonEmptyString" },
        "symbol": { "$ref": "#/$defs/nonEmptyString" },
        "artifact_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "label_ja",
        "role",
        "strength",
        "supports",
        "locator",
        "limitations_ja"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "label_en": { "$ref": "#/$defs/nonEmptyString" },
        "role": {
          "enum": [
            "observation",
            "input_registry",
            "specification",
            "implementation",
            "test",
            "run_artifact",
            "acceptance_decision",
            "design_intent",
            "limitation"
            ,"acquisition"
            ,"data_artifact"
            ,"validation_result"
          ]
        },
        "strength": {
          "enum": ["direct_repository_evidence", "indirect_repository_evidence"]
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/supportTarget" }
        },
        "locator": { "$ref": "#/$defs/locator" },
        "limitations_ja": { "$ref": "#/$defs/nonEmptyString" },
        "does_not_support": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "version": { "type": ["string", "integer", "null"] },
        "git_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "record_state": { "enum": ["current", "superseded", "conflicted"] },
        "regeneration_ja": { "type": ["string", "null"] },
        "portability": { "enum": ["tracked", "untracked_local", "ignored_local", "external_required"] },
        "generated_from_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "superseded_by": { "$ref": "#/$defs/id" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "summary_ja", "node_refs", "relation_refs", "fixed_ranks", "group_refs", "layout_hint", "preset", "filters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "label_en": { "$ref": "#/$defs/nonEmptyString" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "node_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "relation_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "conflict_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "fixed_ranks": { "type": "array", "items": { "$ref": "#/$defs/viewRank" } },
        "group_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "layout_hint": { "enum": ["left_to_right", "top_to_bottom", "grouped", "list"] },
        "preset": { "type": "boolean" },
        "filters": { "type": "object", "additionalProperties": { "type": ["string", "boolean", "array"] } }
      }
    },
    "viewRank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "node_refs"],
      "properties": {
        "rank": { "type": "integer", "minimum": 0 },
        "node_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label_ja", "summary_ja", "node_refs", "default_collapsed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "label_en": { "$ref": "#/$defs/nonEmptyString" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "node_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "default_collapsed": { "type": "boolean" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_ja",
        "summary_ja",
        "resolution_status",
        "evidence_refs",
        "resolution_condition_ja"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_ja": { "$ref": "#/$defs/nonEmptyString" },
        "summary_ja": { "$ref": "#/$defs/nonEmptyString" },
        "resolution_status": { "enum": ["unresolved", "resolved"] },
        "classification": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["stale_documentation", "temporal_update_difference", "granularity_difference", "semantic_conflict", "acceptance_readiness_difference"] },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "resolution_condition_ja": { "$ref": "#/$defs/nonEmptyString" },
        "review": { "$ref": "#/$defs/review" }
      }
    }
  }
}
