{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speed_resolution_record_v17.schema.json",
  "type": "object",
  "required": ["speed_record_id", "configuration_id", "population_version", "profile", "source_way_id", "directed_segment_id", "source_direction", "scenario_context_id", "resolution_status", "value_origin", "speed_kmh", "speed_mps", "speed_kind", "source_key", "source_value", "rule_ids", "source_ids", "assumption_ids", "stop_code", "review_required", "advisory_speed", "source_observations", "provenance"],
  "properties": {
    "speed_record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "configuration_id": {"const": "ota_ward_sumo_network_v17"},
    "population_version": {"type": "string", "minLength": 1},
    "profile": {"enum": ["structural", "formal"]},
    "source_way_id": {"type": "integer", "minimum": 1},
    "directed_segment_id": {"type": "string", "pattern": "^ds:[0-9]+:[0-9]+:[0-9]+:(forward|backward)$"},
    "source_direction": {"enum": ["forward", "backward"]},
    "scenario_context_id": {"type": "string", "minLength": 1},
    "resolution_status": {"enum": ["resolved", "unresolved", "conflict", "invalid", "valid_but_unsupported"]},
    "value_origin": {"enum": ["source_normalized", "rule_derived", "model_assumed", null]},
    "speed_kmh": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 200},
    "speed_mps": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "speed_kind": {"enum": ["source_maxspeed", "conditional_source_maxspeed", "symbolic_fixture", "statutory", "structural_simulation_speed", null]},
    "source_key": {"type": ["string", "null"]},
    "source_value": {"type": ["string", "null"]},
    "rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "assumption_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "stop_code": {"enum": ["SPEED_VALUE_INVALID", "SPEED_VALUE_UNSUPPORTED", "SPEED_RULE_NOT_REGISTERED", "SPEED_CONDITIONAL_CONTEXT_MISSING", "SPEED_WITHIN_INTERVAL_CHANGE", null]},
    "review_required": {"type": "boolean"},
    "advisory_speed": {"type": ["object", "null"]},
    "source_observations": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["resolution", "canonical_unit", "sumo_conversion", "advisory_is_legal_maxspeed", "typemap_used_as_formal_evidence", "japan_speed_registry_id", "japan_speed_registry_version", "unresolved_policy"],
      "properties": {
        "resolution": {"const": "speed_resolution_v17"},
        "canonical_unit": {"const": "km/h"},
        "sumo_conversion": {"const": "speed_mps = speed_kmh / 3.6"},
        "advisory_is_legal_maxspeed": {"const": false},
        "typemap_used_as_formal_evidence": {"const": false},
        "japan_speed_registry_id": {"const": "JAPAN_SPEED_RULES_V17"},
        "japan_speed_registry_version": {"const": "1.0.0"},
        "unresolved_policy": {"const": "SPEED_RULE_NOT_REGISTERED"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"resolution_status": {"const": "resolved"}}, "required": ["resolution_status"]},
      "then": {"properties": {"speed_kmh": {"type": "number"}, "speed_mps": {"type": "number"}, "speed_kind": {"type": "string"}, "value_origin": {"type": "string"}, "stop_code": {"type": "null"}, "review_required": {"const": false}}},
      "else": {"properties": {"speed_kmh": {"type": "null"}, "speed_mps": {"type": "null"}, "speed_kind": {"type": "null"}, "value_origin": {"type": "null"}, "stop_code": {"type": "string"}, "review_required": {"const": true}}}
    },
    {
      "if": {"properties": {"profile": {"const": "formal"}}, "required": ["profile"]},
      "then": {"properties": {"value_origin": {"not": {"const": "model_assumed"}}, "assumption_ids": {"maxItems": 0}}}
    }
  ],
  "additionalProperties": false
}
