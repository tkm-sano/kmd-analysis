{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exclusion_manifest_v17.schema.json",
  "type": "object",
  "required": ["configuration_id", "population_version", "entries", "population_counts"],
  "properties": {
    "configuration_id": {"const": "ota_ward_sumo_network_v17"},
    "population_version": {"type": "string"},
    "entries": {"type": "array", "items": {"type": "object", "required": ["source_way_id", "directed_segment_id", "lane_position", "reason", "exclusion_rule_id", "approver", "approval_date", "evidence_sha256", "population_version"]}},
    "population_counts": {"type": "object", "required": ["input", "governed", "excluded"], "properties": {"input": {"type": "integer", "minimum": 0}, "governed": {"type": "integer", "minimum": 0}, "excluded": {"type": "integer", "minimum": 0}}}
  },
  "additionalProperties": false
}
