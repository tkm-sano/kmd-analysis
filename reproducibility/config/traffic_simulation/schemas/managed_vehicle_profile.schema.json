{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "managed_vehicle_profile.schema.json",
  "title": "Managed delivery vehicle scenario profile",
  "type": "object",
  "required": [
    "schema_version",
    "schema",
    "vehicle_profile_id",
    "profile_status",
    "sumo_vclass",
    "powertrain",
    "osm_access_membership",
    "trip_purpose",
    "maximum_permissible_mass_kg",
    "unladen_mass_kg",
    "maximum_payload_kg",
    "actual_payload_policy",
    "actual_mass_formula",
    "length_m",
    "width_m",
    "height_m",
    "maximum_axle_load_kg",
    "hazardous_goods",
    "permit_ids",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {
      "const": "reproducibility/config/traffic_simulation/schemas/managed_vehicle_profile.schema.json"
    },
    "vehicle_profile_id": {"const": "managed_urban_ev_delivery_v1"},
    "profile_status": {"const": "fixed_model_assumption"},
    "sumo_vclass": {"const": "delivery"},
    "powertrain": {"const": "battery_electric"},
    "osm_access_membership": {
      "type": "object",
      "required": ["vehicle", "motor_vehicle", "goods", "hgv"],
      "properties": {
        "vehicle": {"const": true},
        "motor_vehicle": {"const": true},
        "goods": {"const": true},
        "hgv": {"const": false}
      },
      "additionalProperties": false
    },
    "trip_purpose": {"const": "delivery"},
    "maximum_permissible_mass_kg": {"const": 3500},
    "unladen_mass_kg": {"const": 1500},
    "maximum_payload_kg": {"const": 2000},
    "actual_payload_policy": {"const": "remaining_delivery_load"},
    "actual_mass_formula": {"const": "unladen_mass_kg + actual_payload_kg"},
    "length_m": {"const": 4.7},
    "width_m": {"const": 1.7},
    "height_m": {"const": 2.0},
    "maximum_axle_load_kg": {"const": 2000},
    "hazardous_goods": {"const": false},
    "permit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "interpretation": {
      "type": "object",
      "required": [
        "represents_measured_real_vehicle",
        "hgv_membership_basis",
        "vclass_switch_within_experiment",
        "electric_powertrain_representation"
      ],
      "properties": {
        "represents_measured_real_vehicle": {"const": false},
        "hgv_membership_basis": {"const": "maximum_permissible_mass_not_over_3500_kg"},
        "vclass_switch_within_experiment": {"const": "prohibited"},
        "electric_powertrain_representation": {"const": "sumo_battery_device"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
