{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase12_run_manifest_v17.schema.json",
  "type": "object",
  "required": ["schema_version", "manifest_id", "contract_id", "contract_version", "run_id", "source_commit", "dirty_tree", "configuration_id", "population_version", "input_hashes", "artifacts", "validation_results", "exit_code"],
  "properties": {
    "schema_version": {"const": 17},
    "manifest_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "OTA_WARD_V17_PHASE12_OUTPUT_CONTRACT"},
    "contract_version": {"const": "1.0.0"},
    "run_id": {"enum": ["run_1", "run_2"]},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "dirty_tree": {"const": false},
    "configuration_id": {"const": "ota_ward_sumo_network_v17"},
    "population_version": {"const": "ota_ward_relation_closure_v16"},
    "input_hashes": {"type": "object", "minProperties": 6, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "artifacts": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "validation_results": {"type": "object", "required": ["schema", "semantic", "population_accounting", "identity_uniqueness"], "additionalProperties": {"const": "passed"}},
    "exit_code": {"const": 0}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "path", "schema", "byte_sha256", "semantic_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "byte_sha256": {"$ref": "#/$defs/hash"},
        "semantic_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
