{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predicate_source_registry.schema.json",
  "allOf": [
    {"$ref": "artifact_common.schema.json#/$defs/identity"},
    {
      "type": "object",
      "required": [
        "artifact_type",
        "schema_version",
        "config_id",
        "config_version",
        "run_id",
        "population_acceptance",
        "relation_closed_osm",
        "role_source_artifact_type",
        "role_source",
        "role_decisions",
        "external_predicate_sources",
        "predicate_overrides"
      ],
      "properties": {
        "artifact_type": {
          "const": "attribute_classification_predicate_source_registry"
        },
        "schema_version": {"const": 1},
        "config_id": {"type": "string"},
        "config_version": {"type": "integer"},
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "population_acceptance": {
          "type": "object",
          "required": ["scope", "accepted", "acceptance_artifact"],
          "properties": {
            "scope": {"enum": ["synthetic_fixture", "registered_real_data"]},
            "accepted": {"type": "boolean"},
            "acceptance_artifact": {
              "oneOf": [
                {"$ref": "artifact_common.schema.json#/$defs/file_ref"},
                {"type": "null"}
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "scope": {"const": "registered_real_data"},
                  "accepted": {"const": true}
                }
              },
              "then": {
                "properties": {
                  "acceptance_artifact": {"type": "object"}
                }
              }
            },
            {
              "if": {
                "properties": {"scope": {"const": "synthetic_fixture"}}
              },
              "then": {
                "properties": {
                  "accepted": {"const": true},
                  "acceptance_artifact": {"type": "null"}
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "relation_closed_osm": {
          "$ref": "artifact_common.schema.json#/$defs/file_ref"
        },
        "role_source_artifact_type": {"type": "string", "minLength": 1},
        "role_source": {
          "$ref": "artifact_common.schema.json#/$defs/file_ref"
        },
        "role_decisions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/role_decision"}
        },
        "external_predicate_sources": {
          "type": "object",
          "required": [
            "is_calibration_segment",
            "is_validation_segment",
            "is_major_junction_approach",
            "is_accepted_delivery_route",
            "is_sensitivity_elevated"
          ],
          "properties": {
            "is_calibration_segment": {
              "$ref": "#/$defs/external_predicate_source"
            },
            "is_validation_segment": {
              "$ref": "#/$defs/external_predicate_source"
            },
            "is_major_junction_approach": {
              "$ref": "#/$defs/external_predicate_source"
            },
            "is_accepted_delivery_route": {
              "$ref": "#/$defs/external_predicate_source"
            },
            "is_sensitivity_elevated": {
              "$ref": "#/$defs/external_predicate_source"
            }
          },
          "additionalProperties": false
        },
        "predicate_overrides": {
          "type": "array",
          "items": {"$ref": "#/$defs/predicate_override"}
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "role_decision": {
      "type": "object",
      "required": [
        "osm_way_id",
        "subgraph_role",
        "topology_support_reason",
        "source_record_locator",
        "derivation_rule_id"
      ],
      "properties": {
        "osm_way_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "subgraph_role": {"enum": ["final", "topology_support", "excluded"]},
        "topology_support_reason": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_record_locator": {"type": "string", "minLength": 1},
        "derivation_rule_id": {
          "type": "string",
          "pattern": "^PRED-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"subgraph_role": {"const": "topology_support"}}
          },
          "then": {
            "properties": {
              "topology_support_reason": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {"topology_support_reason": {"type": "null"}}
          }
        }
      ],
      "additionalProperties": false
    },
    "external_predicate_source": {
      "type": "object",
      "required": [
        "source_artifact_type",
        "source",
        "derivation_rule_id",
        "true_way_ids",
        "false_scope"
      ],
      "properties": {
        "source_artifact_type": {"type": "string", "minLength": 1},
        "source": {"$ref": "artifact_common.schema.json#/$defs/file_ref"},
        "derivation_rule_id": {
          "type": "string",
          "pattern": "^PRED-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
        },
        "true_way_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}
        },
        "false_scope": {"const": "all_other_population_ways"}
      },
      "additionalProperties": false
    },
    "predicate_override": {
      "type": "object",
      "required": [
        "osm_way_id",
        "predicate",
        "value",
        "source_artifact_type",
        "source",
        "source_record_locator",
        "derivation_rule_id"
      ],
      "properties": {
        "osm_way_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "predicate": {
          "enum": [
            "is_calibration_segment",
            "is_validation_segment",
            "is_major_junction_approach",
            "is_bridge",
            "is_tunnel",
            "is_grade_separated",
            "has_directional_lane_semantics",
            "has_reversible_lane_semantics",
            "has_tidal_flow_semantics",
            "has_turn_lane_semantics",
            "has_bus_or_psv_lane_semantics",
            "has_conflicting_lane_semantics",
            "has_directional_speed_semantics",
            "has_conditional_speed_semantics",
            "has_variable_speed_semantics",
            "has_vehicle_specific_speed_semantics",
            "has_advisory_or_multiple_speed_semantics",
            "is_accepted_delivery_route",
            "is_sensitivity_elevated"
          ]
        },
        "value": {"type": "boolean"},
        "source_artifact_type": {"type": "string", "minLength": 1},
        "source": {"$ref": "artifact_common.schema.json#/$defs/file_ref"},
        "source_record_locator": {"type": "string", "minLength": 1},
        "derivation_rule_id": {
          "type": "string",
          "pattern": "^PRED-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
        }
      },
      "additionalProperties": false
    }
  }
}
