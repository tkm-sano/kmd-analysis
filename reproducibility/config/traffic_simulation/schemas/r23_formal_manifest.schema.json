{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r23-reduced-qaoa-aer-formal-manifest-v2",
  "title": "R23 reduced forward-looking formal artifact contract",
  "description": "Schema only; does not authorize or record a formal experiment.",
  "type": "object",
  "required": ["schema_version", "classification", "configuration_id", "configuration_semantic_sha256", "source_commit", "environment", "lineage", "run_ids", "artifact_file_hashes", "runtime_contract"],
  "properties": {
    "schema_version": {"const": "r23-reduced-qaoa-aer-formal-manifest-v2"},
    "classification": {"const": "FORMAL_ARTIFACT_CONTRACT_ONLY"},
    "configuration_id": {"type": "string"},
    "configuration_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string"},
    "environment": {"type": "object"},
    "lineage": {
      "type": "object",
      "required": ["R20", "R21", "R22", "R23"],
      "properties": {
        "R20": {"type": "object", "required": ["specification_path", "specification_sha256", "formulation_identifier"]},
        "R21": {"type": "object", "required": ["authoritative_results_path", "authoritative_results_sha256", "authoritative_manifest_path", "authoritative_manifest_sha256", "coefficient_hash_identifier", "status"]},
        "R22": {"type": "object", "required": ["authoritative_results_path", "authoritative_results_sha256", "authoritative_manifest_path", "authoritative_manifest_sha256", "coefficient_hash_identifier", "status"]},
        "R23": {"type": "object", "required": ["source_file_hashes", "configuration_id", "configuration_semantic_sha256"]}
      }
    },
    "run_ids": {"type": "array", "items": {"type": "string"}},
    "artifact_file_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "runtime_contract": {"type": "object", "required": ["T_total", "T_optimizer_total", "T_objective_eval_total", "T_Aer_total", "T_expectation_total", "T_final_evaluation", "double_counting_rule"]}
  }
}
