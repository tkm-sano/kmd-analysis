{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manual_evidence_record_v17.schema.json",
  "type": "object",
  "required": ["schema_version", "evidence_record_id", "evidence_version", "source", "reviewer", "decision", "reason", "affected_record_ids", "review_date", "evidence_sha256", "production_output_edit", "requires_regeneration"],
  "properties": {
    "schema_version": {"const": 17},
    "evidence_record_id": {"type": "string", "minLength": 1},
    "evidence_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "object", "required": ["description", "path_or_url", "sha256"], "properties": {"description": {"type": "string", "minLength": 1}, "path_or_url": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "reviewer": {"type": "string", "minLength": 1},
    "decision": {"type": "object", "minProperties": 1},
    "reason": {"type": "string", "minLength": 1},
    "affected_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "review_date": {"type": "string", "format": "date"},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "production_output_edit": {"const": false},
    "requires_regeneration": {"const": true}
  },
  "additionalProperties": false
}
