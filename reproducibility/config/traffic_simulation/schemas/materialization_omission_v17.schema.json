{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "materialization_omission_v17.schema.json",
  "type": "object",
  "required": ["source_way_id", "directed_segment_id", "resolver_tuple_ids", "reason_code", "expected_permission_set", "omitted_edge_id", "affected_connection_ids", "configuration_hash", "permission_expectation_hash", "materializer_output_hash"],
  "properties": {
    "source_way_id": {"type": "integer", "minimum": 1},
    "directed_segment_id": {"type": "string"},
    "resolver_tuple_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "reason_code": {"type": "string"},
    "expected_permission_set": {"type": "array", "maxItems": 0},
    "omitted_edge_id": {"type": ["string", "null"]},
    "affected_connection_ids": {"type": "array", "uniqueItems": true},
    "configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "permission_expectation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "materializer_output_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
