{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approved_attribute_resolution_policy.schema.json",
  "title": "v17 attribute-resolution policy authority index",
  "type": "object",
  "required": ["schema_version", "schema", "policy_id", "policy_status", "approved_by", "approved_at", "normative_specification", "phase1_configuration", "requirements_traceability", "semantic_invariants", "registry_bundle", "effective_configuration", "phase1_authority_status", "implementation_status", "runtime_validation_status", "attribute_resolution_acceptance", "formal_build_ready", "historical_boundary"],
  "properties": {
    "schema_version": {"const": 2},
    "schema": {"const": "reproducibility/config/traffic_simulation/schemas/approved_attribute_resolution_policy.schema.json"},
    "policy_id": {"const": "ota_ward_attribute_resolution_policy_v17"},
    "policy_status": {"const": "fixed"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date"},
    "normative_specification": {"const": "05_src/traffic_simulation/specifications/10_approved_attribute_resolution_policy_v17_complete.md"},
    "phase1_configuration": {"const": "reproducibility/config/traffic_simulation/sumo_network_v17.yml"},
    "requirements_traceability": {"const": "05_src/traffic_simulation/specifications/v17_attribute_resolution_traceability_matrix.md"},
    "semantic_invariants": {"const": "reproducibility/config/traffic_simulation/v17_semantic_invariants.yml"},
    "registry_bundle": {"const": "reproducibility/config/traffic_simulation/attribute_resolution_registries_v17.yml"},
    "effective_configuration": {"type": "object", "required": ["from", "until"], "properties": {"from": {"const": 17}, "until": {"type": "null"}}, "additionalProperties": false},
    "phase1_authority_status": {"const": "complete"},
    "implementation_status": {"const": "partial"},
    "runtime_validation_status": {"const": "incomplete"},
    "attribute_resolution_acceptance": {"const": "not_run"},
    "formal_build_ready": {"const": false},
    "historical_boundary": {"type": "object", "required": ["v16_immutable", "v16_relabel_as_v17"], "properties": {"v16_immutable": {"const": true}, "v16_relabel_as_v17": {"const": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
