{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal_evidence_methods_v17.schema.json",
  "type": "object",
  "required": ["schema_version", "schema", "registry_id", "registry_version", "policy_id", "status", "approved_by", "approved_at", "approved_method_count", "methods", "default_policy", "minimum_donor_eligibility", "validation_contract", "manual_evidence_contract", "output_policy"],
  "properties": {
    "schema_version": {"const": 17},
    "schema": {"const": "reproducibility/config/traffic_simulation/schemas/formal_evidence_methods_v17.schema.json"},
    "registry_id": {"const": "FORMAL_EVIDENCE_METHODS_V17"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_id": {"const": "ota_ward_attribute_resolution_policy_v17"},
    "status": {"const": "approved"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date"},
    "approved_method_count": {"type": "integer", "minimum": 0},
    "no_method_approval_reason": {"type": "string", "minLength": 1},
    "methods": {"type": "array", "items": {"$ref": "#/$defs/method"}},
    "default_policy": {
      "type": "object",
      "required": ["unregistered_method", "ineligible_donor"],
      "properties": {
        "unregistered_method": {"const": "EVIDENCE_METHOD_NOT_APPROVED"},
        "ineligible_donor": {"const": "EVIDENCE_DONOR_INELIGIBLE"}
      },
      "additionalProperties": false
    },
    "minimum_donor_eligibility": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["eligible_population_match", "formal_direction_resolved", "formal_directional_lanes_resolved_when_relevant", "formal_speed_resolved_when_relevant", "no_relevant_unsupported_conditional", "formal_permissions_resolved_when_relevant", "no_structural_assumption", "not_model_assumed", "traceable_source_hash", "traceable_configuration_hash"]}
    },
    "validation_contract": {
      "type": "object",
      "required": ["dataset_required", "metrics_required", "acceptance_thresholds_required", "uncertainty_output_required", "fixture_and_oracle_hashes_required"],
      "properties": {
        "dataset_required": {"const": true},
        "metrics_required": {"const": true},
        "acceptance_thresholds_required": {"const": true},
        "uncertainty_output_required": {"const": true},
        "fixture_and_oracle_hashes_required": {"const": true}
      },
      "additionalProperties": false
    },
    "manual_evidence_contract": {
      "type": "object",
      "required": ["separate_versioned_artifact", "direct_output_edit", "regenerate_complete_artifact", "schema"],
      "properties": {
        "separate_versioned_artifact": {"const": true},
        "direct_output_edit": {"const": false},
        "regenerate_complete_artifact": {"const": true},
        "schema": {"const": "reproducibility/config/traffic_simulation/schemas/manual_evidence_record_v17.schema.json"}
      },
      "additionalProperties": false
    },
    "output_policy": {
      "type": "object",
      "required": ["emit_evidence_derived_without_approved_method", "emit_derived_validated_model_without_approved_method"],
      "properties": {
        "emit_evidence_derived_without_approved_method": {"const": false},
        "emit_derived_validated_model_without_approved_method": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "method": {
      "type": "object",
      "required": ["method_id", "status", "target_attribute", "output_origin", "eligible_population", "required_inputs", "donor_eligibility", "estimator_or_model", "validation_dataset", "validation_metrics", "acceptance_thresholds", "uncertainty_output", "provenance_fields", "approver", "approval_date", "implementation_hash", "fixture_hash", "oracle_hash"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "status": {"const": "approved"},
        "target_attribute": {"type": "string", "minLength": 1},
        "output_origin": {"enum": ["evidence_derived", "derived_validated_model"]},
        "eligible_population": {"type": "object", "minProperties": 1},
        "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "donor_eligibility": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "estimator_or_model": {"type": "object", "minProperties": 1},
        "validation_dataset": {"type": "object", "required": ["dataset_id", "sha256"], "properties": {"dataset_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}, "additionalProperties": true},
        "validation_metrics": {"type": "object", "minProperties": 1},
        "acceptance_thresholds": {"type": "object", "minProperties": 1},
        "uncertainty_output": {"type": "object", "minProperties": 1},
        "provenance_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "approver": {"type": "string", "minLength": 1},
        "approval_date": {"type": "string", "format": "date"},
        "implementation_hash": {"$ref": "#/$defs/hash"},
        "fixture_hash": {"$ref": "#/$defs/hash"},
        "oracle_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
