{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v17_attribute_resolution_oracle_catalog.schema.json",
  "type": "object",
  "required": ["artifact_type", "schema_version", "oracle_collection_id", "policy_id", "independence", "oracles"],
  "properties": {
    "artifact_type": {"const": "v17_attribute_resolution_oracle_catalog"},
    "schema_version": {"const": 1},
    "oracle_collection_id": {"const": "ota_ward_attribute_resolution_v17_oracles_v1"},
    "policy_id": {"const": "ota_ward_attribute_resolution_policy_v17"},
    "independence": {
      "type": "object",
      "required": ["authored_from_normative_specification", "production_code_used_to_derive_expected_values", "production_output_compared_during_authoring", "oracle_author_role", "reviewer_role", "relationship_to_production_implementation"],
      "properties": {
        "authored_from_normative_specification": {"const": true},
        "production_code_used_to_derive_expected_values": {"const": false},
        "production_output_compared_during_authoring": {"const": false},
        "oracle_author_role": {"const": "production_independent_oracle_author"},
        "reviewer_role": {"const": "specification_conformance_reviewer"},
        "relationship_to_production_implementation": {"const": "independent"}
      },
      "additionalProperties": false
    },
    "oracles": {
      "type": "array",
      "minItems": 55,
      "items": {
        "type": "object",
        "required": ["oracle_id", "outcome", "resolution_status", "value_origin", "effective_value", "stop_code", "assertions"],
        "properties": {
          "oracle_id": {"type": "string", "pattern": "^OR-V17-[0-9]{3}$"},
          "outcome": {"enum": ["resolved", "stopped", "accounted", "metamorphic_pass"]},
          "resolution_status": {"enum": ["resolved", "unresolved", "conflict", "invalid", "valid_but_unsupported", null]},
          "value_origin": {"enum": ["source_explicit", "source_normalized", "rule_derived", "evidence_derived", "derived_validated_model", "model_assumed", null]},
          "effective_value": {},
          "stop_code": {"type": ["string", "null"]},
          "assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
