{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirements_traceability.schema.json",
  "type": "object",
  "required": ["schema_version", "config_id", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "config_id": {"type": "string", "pattern": "^ota_ward_sumo_network_v[0-9]+$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "component", "test_ids", "fixture_class", "implementation_state"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^(SIM|ARC|RS|AC|PM|TLS|BLD|PA)-REQ-[0-9]{3}$"},
          "component": {"enum": ["research", "architecture", "resolver", "attribute_criticality", "permission_materializer", "tls_review", "final_build", "post_build_audit"]},
          "test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(SIM|ARC|RS|AC|PM|TLS|BLD|PA)-TST-[0-9]{3}$"}},
          "fixture_class": {"enum": ["positive", "boundary", "negative", "repeat", "research_comparison", "state_contract"]},
          "implementation_state": {"enum": ["implemented", "partial", "specified_not_implemented"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
