+// Optional, diagnostics-only JSONL trace for getKPaths / computePath.
+// Enabled with SUMO_MAROUTER_GETKPATHS_TRACE. The routing algorithm and all
+// routing inputs remain unchanged when tracing is enabled.
+namespace {
+std::ofstream* gKPathsTrace = nullptr;
+int gKPathsIteration = -1;
+int gKPathsRequested = -1;
+bool gInKPaths = false;
+
+std::string
+jsonString(const std::string& value) {
+    std::ostringstream out;
+    out << '"';
+    for (const unsigned char c : value) {
+        switch (c) {
+            case '"': out << "\\\""; break;
+            case '\\': out << "\\\\"; break;
+            case '\b': out << "\\b"; break;
+            case '\f': out << "\\f"; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    out << "\\u" << std::hex << std::setw(4) << std::setfill('0') << (int)c << std::dec;
+                } else {
+                    out << c;
+                }
+        }
+    }
+    out << '"';
+    return out.str();
+}
+
+std::string
+traceEnv(const char* name) {
+    const char* const value = std::getenv(name);
+    return value == nullptr ? "" : value;
+}
+
+std::ofstream*
+getKPathsTrace() {
+    if (gKPathsTrace == nullptr) {
+        const std::string path = traceEnv("SUMO_MAROUTER_GETKPATHS_TRACE");
+        if (!path.empty()) {
+            gKPathsTrace = new std::ofstream(path.c_str(), std::ios::out | std::ios::trunc);
+            if (!gKPathsTrace->good()) {
+                delete gKPathsTrace;
+                gKPathsTrace = nullptr;
+            }
+        }
+    }
+    return gKPathsTrace;
+}
+
+bool
+traceCell(const ODCell* const cell) {
+    if (getKPathsTrace() == nullptr) {
+        return false;
+    }
+    const std::string origin = traceEnv("SUMO_MAROUTER_TRACE_ORIGIN");
+    const std::string destination = traceEnv("SUMO_MAROUTER_TRACE_DESTINATION");
+    return (origin.empty() || origin == cell->origin)
+           && (destination.empty() || destination == cell->destination);
+}
+
+bool
+containsTarget(const ConstROEdgeVector& edges) {
+    const std::string target = traceEnv("SUMO_MAROUTER_TRACE_TARGET_EDGE");
+    if (target.empty()) {
+        return false;
+    }
+    for (const ROEdge* const edge : edges) {
+        if (edge->getID() == target) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void
+writeEdges(std::ostream& out, const ConstROEdgeVector& edges) {
+    out << '[';
+    bool first = true;
+    for (const ROEdge* const edge : edges) {
+        if (!first) {
+            out << ',';
+        }
+        first = false;
+        out << jsonString(edge->getID());
+    }
+    out << ']';
+}
+
+void
+writeComputeTrace(const ODCell* const cell, const ConstROEdgeVector& edges,
+                  const char* const outcome, const bool searchExecuted,
+                  const bool duplicate, const int duplicateIndex,
+                  const double searchCost, const int routesBefore,
+                  const int routesAfter) {
+    if (!gInKPaths || !traceCell(cell)) {
+        return;
+    }
+    std::ofstream& out = *getKPathsTrace();
+    out << std::setprecision(17)
+        << "{\"event\":\"compute_path_result\",\"origin\":" << jsonString(cell->origin)
+        << ",\"destination\":" << jsonString(cell->destination)
+        << ",\"iteration_zero_based\":" << gKPathsIteration
+        << ",\"iteration_one_based\":" << (gKPathsIteration + 1)
+        << ",\"requested_iterations\":" << gKPathsRequested
+        << ",\"outcome\":" << jsonString(outcome)
+        << ",\"search_executed\":" << (searchExecuted ? "true" : "false")
+        << ",\"search_cost\":";
+    if (searchExecuted && !edges.empty()) {
+        out << searchCost;
+    } else {
+        out << "null";
+    }
+    out << ",\"generated_edge_count\":" << edges.size()
+        << ",\"generated_edges\":";
+    writeEdges(out, edges);
+    out << ",\"target_edge\":" << jsonString(traceEnv("SUMO_MAROUTER_TRACE_TARGET_EDGE"))
+        << ",\"target_edge_present\":" << (containsTarget(edges) ? "true" : "false")
+        << ",\"duplicate\":" << (duplicate ? "true" : "false")
+        << ",\"duplicate_route_index\":";
+    if (duplicateIndex >= 0) {
+        out << duplicateIndex;
+    } else {
+        out << "null";
+    }
+    out << ",\"routes_before\":" << routesBefore
+        << ",\"routes_after\":" << routesAfter << "}\n";
+    out.flush();
+}
+}
+
