# Hayate is the canonical execution and large-data environment.
RESEARCH_CANONICAL_HOST=hayate.q-est.wide.ad.jp
RESEARCH_CANONICAL_USER=takuma
RESEARCH_PERSISTENT_ROOT=/home/takuma/kmd-analysis
RESEARCH_REPO_ROOT=/home/takuma/kmd-analysis
RESEARCH_WORK_ROOT=/home/takuma/kmd-analysis/reproducibility/outputs
RESEARCH_WORK_STORAGE_CLASS=logical_temporary_area_on_home_nfs
RESEARCH_CONDA_PREFIX=/home/takuma/kmd-analysis/.conda
RESEARCH_SUMO_ROOT=/home/takuma/kmd-analysis/.local/sumo-1.24.0
RESEARCH_REQUIREMENTS=/home/takuma/kmd-analysis/reproducibility/environment/requirements-analysis.txt

# Canonical native runtime requirements.
RESEARCH_REQUIRED_SUMO_VERSION=1.24.0
RESEARCH_REQUIRED_PYTHON_VERSION=3.11.15

# Optional secondary Docker cross-check; not the canonical Hayate runtime.
RESEARCH_OPTIONAL_SUMO_IMAGE=ghcr.io/eclipse-sumo/sumo@sha256:a49874e6e5e355de055e6a10eefd819d48fab8f0047c3130f782a7dfdf1cc189

# A run must provide an immutable, meaningful identifier.
# RESEARCH_RUN_ID=YYYYMMDD_task_scenario_seed
