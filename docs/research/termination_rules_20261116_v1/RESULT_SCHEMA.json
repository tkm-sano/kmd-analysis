{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed finite-work functional-check result; independent execution, plan and adoption axes",
  "type": "object",
  "required": ["run_id", "method", "scale", "contract_id", "config_hash", "input_hash", "OD_hash", "input_state", "execution_state", "algorithm_termination", "plan_state", "validation_state", "adoptable", "D", "W", "T_program", "T_attempt", "branches"],
  "properties": {
    "contract_id": {"const": "whole-method-finite-work-v1"},
    "method": {"enum": ["A", "B", "C", "D", "D_CLASSICAL_REPLACEMENT"]},
    "input_state": {"enum": ["VALID", "INVALID", "NOT_CHECKED"]},
    "execution_state": {"enum": ["NORMAL", "ERROR", "RESOURCE_STOP", "USER_CANCELLED", "EXTERNAL_INTERRUPTION"]},
    "algorithm_termination": {"type": ["string", "null"]},
    "plan_state": {"enum": ["VALID", "INVALID", "NO_PLAN"]},
    "validation_state": {"enum": ["VALIDATED", "INVALID_PLAN", "NO_PLAN", "NOT_RUN"]},
    "adoptable": {"type": "boolean"},
    "D": {"type": ["number", "null"], "minimum": 0},
    "W": {"type": ["number", "null"], "minimum": 0},
    "T_program": {"type": ["number", "null"], "minimum": 0},
    "T_attempt": {"type": "number", "minimum": 0},
    "branches": {"type": "array", "minItems": 1, "maxItems": 4,
      "items": {"type": "object", "required": ["branch_id", "execution_state", "plan_state", "adoptable"],
        "properties": {"branch_id": {"type": "integer", "minimum": 0, "maximum": 3}, "adoptable": {"type": "boolean"}}}}
  },
  "allOf": [
    {"if": {"properties": {"adoptable": {"const": true}}},
     "then": {"required": ["plan_sha256", "selected_branch_id"], "properties": {
       "input_state": {"const": "VALID"}, "execution_state": {"const": "NORMAL"},
       "plan_state": {"const": "VALID"}, "validation_state": {"const": "VALIDATED"},
       "D": {"type": "number"}, "W": {"type": "number"}, "T_program": {"type": "number"}}},
     "else": {"properties": {"D": {"type": "null"}, "W": {"type": "null"}, "T_program": {"type": "null"}}}},
    {"if": {"properties": {"method": {"const": "A"}}},
     "then": {"properties": {"branches": {"minItems": 1, "maxItems": 1}}},
     "else": {"properties": {"branches": {"minItems": 4, "maxItems": 4}}}}
  ]
}
